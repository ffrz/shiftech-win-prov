{
  "name": "technician",
  "description": "Technician diagnostic and support workstation",

  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror"
  },

  "applications": [
    { "id": "chrome",       "local": "chrome",       "winget": "Google.Chrome", "enabled": true,  "required": true },
    { "id": "7zip",         "local": "7zip",                                    "enabled": true,  "required": true },
    { "id": "winrar",       "local": "winrar",                                  "enabled": true,  "required": false },
    { "id": "wu10man",      "local": "wu10man",                                 "enabled": true,  "required": false },
    { "id": "cpuz",         "winget": "CPUID.CPU-Z",                            "enabled": true,  "required": false },
    { "id": "hwmonitor",    "winget": "CPUID.HWMonitor",                        "enabled": true,  "required": false },
    { "id": "crystaldisk",  "winget": "CrystalDewWorld.CrystalDiskInfo",        "enabled": true,  "required": false },
    { "id": "aact",         "local": "aact",                                    "enabled": false, "required": false },
    { "id": "kmsoffline",   "local": "kmsoffline",                              "enabled": false, "required": false }
  ],

  "config": [
    { "id": "set-power-high-performance", "enabled": true },
    { "id": "show-file-extensions",       "enabled": true },
    { "id": "show-hidden-files",          "enabled": true },
    { "id": "enable-rdp",                 "enabled": true }
  ]
}
