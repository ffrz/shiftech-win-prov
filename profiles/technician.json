{
  "name": "technician",
  "description": "Technician diagnostic and support workstation",

  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror"
  },

  "applications": [
    { "id": "7zip",         "source": "local",                                          "enabled": true,  "required": true },
    { "id": "chrome",       "source": "winget", "wingetId": "Google.Chrome",             "enabled": true,  "required": true },
    { "id": "winrar",       "source": "local",                                          "enabled": true,  "required": false },
    { "id": "wu10man",      "source": "local",                                          "enabled": true,  "required": false },
    { "id": "cpuz",         "source": "winget", "wingetId": "CPUID.CPU-Z",               "enabled": true,  "required": false },
    { "id": "hwmonitor",    "source": "winget", "wingetId": "CPUID.HWMonitor",           "enabled": true,  "required": false },
    { "id": "crystaldisk",  "source": "winget", "wingetId": "CrystalDewWorld.CrystalDiskInfo", "enabled": true, "required": false },
    { "id": "aact",         "source": "local",                                          "enabled": false, "required": false },
    { "id": "kmsoffline",   "source": "local",                                          "enabled": false, "required": false }
  ],

  "config": [
    { "id": "set-power-high-performance", "enabled": true },
    { "id": "show-file-extensions",       "enabled": true },
    { "id": "show-hidden-files",          "enabled": true },
    { "id": "enable-rdp",                 "enabled": true }
  ]
}
