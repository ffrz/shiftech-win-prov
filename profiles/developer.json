{
  "name": "developer",
  "description": "Developer workstation",

  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror"
  },

  "applications": [
    { "id": "chrome",   "local": "chrome",   "winget": "Google.Chrome",             "enabled": true,  "required": true },
    { "id": "7zip",      "local": "7zip",                                            "enabled": true,  "required": true },
    { "id": "git",       "winget": "Git.Git",                                        "enabled": true,  "required": true },
    { "id": "vscode",    "winget": "Microsoft.VisualStudioCode",                     "enabled": true,  "required": true },
    { "id": "terminal",  "winget": "Microsoft.WindowsTerminal",                      "enabled": true,  "required": false },
    { "id": "nodejs",    "winget": "OpenJS.NodeJS.LTS",                              "enabled": false, "required": false },
    { "id": "python",    "winget": "Python.Python.3.12",                             "enabled": false, "required": false }
  ],

  "config": [
    { "id": "show-file-extensions", "enabled": true },
    { "id": "show-hidden-files",    "enabled": true },
    { "id": "disable-fast-startup", "enabled": true },
    { "id": "clean-taskbar-pins",   "enabled": false }
  ]
}
