{
  "name": "developer",
  "description": "Developer workstation",

  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror"
  },

  "applications": [
    { "id": "chrome",  "source": "winget", "wingetId": "Google.Chrome",              "enabled": true, "required": true },
    { "id": "7zip",    "source": "winget", "wingetId": "7zip.7zip",                   "enabled": true, "required": true },
    { "id": "git",     "source": "winget", "wingetId": "Git.Git",                     "enabled": true, "required": true },
    { "id": "vscode",  "source": "winget", "wingetId": "Microsoft.VisualStudioCode",  "enabled": true, "required": true },
    { "id": "terminal","source": "winget", "wingetId": "Microsoft.WindowsTerminal",   "enabled": true, "required": false },
    { "id": "nodejs",  "source": "winget", "wingetId": "OpenJS.NodeJS.LTS",           "enabled": false, "required": false },
    { "id": "python",  "source": "winget", "wingetId": "Python.Python.3.12",          "enabled": false, "required": false }
  ],

  "config": [
    { "id": "show-file-extensions", "enabled": true },
    { "id": "show-hidden-files",    "enabled": true },
    { "id": "disable-fast-startup", "enabled": true },
    { "id": "clean-taskbar-pins",   "enabled": false }
  ]
}
