{
  "name": "lengkap",
  "description": "Profil komplit - semua contoh config tweak dan aplikasi (local dulu, winget fallback).",
  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror"
  },
  "config": [
    { "id": "show-file-extensions", "enabled": true },
    { "id": "show-hidden-files", "enabled": true },
    { "id": "disable-hibernate", "enabled": true },
    { "id": "set-power-high-performance", "enabled": true },
    { "id": "set-timezone", "enabled": true, "args": { "id": "SE Asia Standard Time" } },
    { "id": "enable-rdp", "enabled": false },
    { "id": "disable-password-expiry", "enabled": true }
  ],
  "applications": [
    { "id": "chrome",       "local": "chrome",       "winget": "Google.Chrome",     "enabled": true, "required": true },
    { "id": "firefox",      "local": "firefox",      "winget": "Mozilla.Firefox",   "enabled": true },
    { "id": "zoom",         "local": "zoom",         "winget": "Zoom.Zoom",         "enabled": true },
    { "id": "7zip",         "local": "7zip",                                        "enabled": true },
    { "id": "winrar",       "local": "winrar",                                      "enabled": true },
    { "id": "adobe-reader", "local": "adobe-reader",                                "enabled": true },
    { "id": "wu10man",      "local": "wu10man",                                     "enabled": true },
    { "id": "aact",         "local": "aact",                                        "enabled": true },
    { "id": "kmsoffline",   "local": "kmsoffline",                                  "enabled": true },
    { "id": "vlc",          "winget": "VideoLAN.VLC",                               "enabled": true },
    { "id": "vscode",       "winget": "Microsoft.VisualStudioCode",                 "enabled": false },
    { "id": "notepadpp",    "winget": "Notepad++.Notepad++",                        "enabled": true },
    { "id": "git",          "winget": "Git.Git",                                    "enabled": false }
  ]
}
