{
  "name": "standard",
  "description": "Standard workstation - drivers via Windows Update, core apps, light cleanup",

  "drivers": {
    "enabled": true,
    "providerOrder": "localcache,windowsupdate,mirror",
    "installUnsigned": false,
    "exclude": []
  },

  "applications": [
    { "id": "chrome",        "source": "winget", "wingetId": "Google.Chrome",         "enabled": true,  "required": true },
    { "id": "7zip",          "source": "winget", "wingetId": "7zip.7zip",             "enabled": true,  "required": true },
    { "id": "winrar",        "source": "local",                                       "enabled": true,  "required": false },
    { "id": "adobe-reader",  "source": "local",                                       "enabled": true,  "required": false },
    { "id": "Zoom.Zoom",     "source": "winget",                                      "enabled": true,  "required": false },
    { "id": "aact",          "source": "local",                                       "enabled": true,  "required": false },
    { "id": "kmsoffline",    "source": "local",                                       "enabled": true,  "required": false },
    { "id": "wu10man",       "source": "local",                                       "enabled": true,  "required": false }
  ],

  "config": [
    { "id": "disable-password-expiry", "enabled": true },
    { "id": "clean-taskbar-pins",      "enabled": true },
    { "id": "show-file-extensions",    "enabled": true },
    { "id": "clean-startup-items",     "enabled": true }
  ]
}
